# Secrets MUST be configured only on the private Bot host. Never place these in Blogger HTML/APK.
TOKEN=YOUR_DISCORD_BOT_TOKEN
FIREBASE_DB_URL=https://rkbackles-default-rtdb.firebaseio.com
# Leave empty to load ./firebase-service-account.json on the Bot host, or use a secret env var containing the service account JSON.
FIREBASE_CONFIG=
PORT=3000

# Comma-separated UID(s) copied from the trusted Android Payment Reader app.
PAYMENT_READER_UIDS=PASTE_ANDROID_READER_FIREBASE_UID_HERE
READER_ONLINE_WINDOW_MS=90000
READER_RECHECK_COOLDOWN_MS=15000
READER_AUTO_WATCH_INTERVAL_MS=15000
READER_AUTO_WATCH_TIMEOUT_MS=300000
PAYMENT_TXN_SUBMIT_COOLDOWN_MS=15000

# Optional fallback payment numbers; the protected Admin Panel config takes precedence once saved.
BKASH_PAYMENT_NUMBER=
NAGAD_PAYMENT_NUMBER=

# C++ Realtime Bridge: C++ source must point CPP_API_BASE_URL to this Bot service HTTPS origin.
# Firebase Web API key is public client configuration and is kept in firebase/web-config.js / C++ source; never put Admin credentials there.

# C++ active session lease; active sessions can be reclaimed after this heartbeat timeout.
CPP_SESSION_STALE_MS=120000

# Exact origins allowed to call authenticated Admin API from Blogger/HTTPS panel (comma-separated).
# Comma-separated exact HTTPS origins allowed to call authenticated Admin API endpoints.
# Include the final published Blogger/Netlify custom domain without a trailing slash.
ADMIN_PANEL_ORIGINS=https://your-blog.blogspot.com
# IMPORTANT: use the exact live page origin from the admin panel status message, without a trailing slash. Restart/redeploy Bot after changing this.
# Example Bot API URL to enter inside C++ Account Admin Panel: your deployed service origin (e.g. https://your-service.onrender.com). Do not include a path.

# Optional Bengali notification channel (Admin Panel can override this)
ANNOUNCEMENT_CHANNEL_ID=
# Optional absolute path to FFmpeg; ffmpeg-static is installed by npm
FFMPEG_PATH=

# Live two-way voice: microphone audio is relayed in-memory (never written to disk).
# WebSocket origin uses the exact same ADMIN_PANEL_ORIGINS allowlist.
# Browser live sessions require HTTPS/WSS, permissions: View Channel/Connect/Speak, and an installed FFmpeg binary.
LIVE_VOICE_MAX_DURATION_MS=1800000

# Optional browser Live Studio (screen/window/Chrome-tab share + realtime web voice).
# The project URL is preconfigured in the app. Set the two private credentials only in Render Environment.
LIVEKIT_URL=wss://sabbir-ylq7x559.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVE_STUDIO_MAX_DURATION_MS=14400000
LIVE_STUDIO_INVITE_TTL_MS=600000
LIVE_STUDIO_MAX_PARTICIPANTS=20

# Live Studio Discord OAuth (required so Discord role/user ID permissions are verified server-side).
# In Discord Developer Portal, register this exact redirect URL under OAuth2 -> Redirects.
LIVE_STUDIO_OAUTH_CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID
LIVE_STUDIO_OAUTH_CLIENT_SECRET=YOUR_DISCORD_APPLICATION_CLIENT_SECRET
LIVE_STUDIO_OAUTH_REDIRECT_URI=https://sbsx.onrender.com/api/live-studio/auth/callback
# Comma-separated IDs. Guild owner and members with Discord Administrator permission always qualify.
# Keep these lists in Render Environment only; never paste the OAuth secret into Blogger or chat.
LIVE_STUDIO_ADMIN_USER_IDS=
LIVE_STUDIO_ADMIN_ROLE_IDS=
